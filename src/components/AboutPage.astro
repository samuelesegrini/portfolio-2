---
import { render } from 'astro:content';
import type { Locale } from '../lib/content';
import { getPortfolioContent } from '../lib/portfolio';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const { aboutDocuments } = await getPortfolioContent();
const document = aboutDocuments.find((entry) => !entry.data.draft && entry.data.locale === lang);
if (!document) throw new Error(`Missing About page for ${lang}`);
const { Content } = await render(document);
const isIt = lang === 'it';
const currentPath = isIt ? '/it/chi-sono/' : '/en/about/';
---

<BaseLayout
	lang={lang}
	title={document.data.seoTitle ?? `${document.data.title} — ${siteConfig.name}`}
	description={document.data.seoDescription ?? document.data.excerpt}
	translationURL={isIt ? '/en/about/' : '/it/chi-sono/'}
	canonicalPath={currentPath}
	alternateIt="/it/chi-sono/"
	alternateEn="/en/about/"
>
	<header class="page-hero dark-section"><p class="eyebrow">{isIt ? 'Profilo' : 'Profile'}</p><h1>{document.data.title}</h1><p>{document.data.excerpt}</p></header>
	<section class="section about-page"><div class="prose"><Content /></div><aside class="cv-panel"><p class="eyebrow dark">CV</p>{siteConfig.isPlaceholder ? <p>{isIt ? 'Aggiungi cv-it.pdf e cv-en.pdf prima del lancio.' : 'Add cv-it.pdf and cv-en.pdf before launch.'}</p> : <div><a class="primary-button" href={isIt ? '/cv/cv-it.pdf' : '/cv/cv-en.pdf'}>{isIt ? 'Scarica il CV' : 'Download résumé'}</a></div>}</aside></section>
</BaseLayout>
