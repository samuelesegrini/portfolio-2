---
import PostDetail from '../../../components/PostDetail.astro';
import { getPortfolioContent } from '../../../lib/portfolio';

export async function getStaticPaths() {
	const { postDocuments } = await getPortfolioContent();
	return postDocuments.filter(({ data }) => !data.draft && data.locale === 'en').map((document) => ({ params: { slug: document.data.slug }, props: { document } }));
}
const { document } = Astro.props;
---
<PostDetail document={document} />
